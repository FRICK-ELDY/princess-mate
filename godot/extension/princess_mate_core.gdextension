[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://../rust/princess-mate-core/target/debug/princess_mate_core.dll"
windows.release.x86_64 = "res://../rust/princess-mate-core/target/release/princess_mate_core.dll"
linux.debug.x86_64 = "res://../rust/princess-mate-core/target/debug/libprincess_mate_core.so"
linux.release.x86_64 = "res://../rust/princess-mate-core/target/release/libprincess_mate_core.so"
macos.debug = "res://../rust/princess-mate-core/target/debug/libprincess_mate_core.dylib"
macos.release = "res://../rust/princess-mate-core/target/release/libprincess_mate_core.dylib"
macos.debug.arm64 = "res://../rust/princess-mate-core/target/debug/libprincess_mate_core.dylib"
macos.release.arm64 = "res://../rust/princess-mate-core/target/release/libprincess_mate_core.dylib"
