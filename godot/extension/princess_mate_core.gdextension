[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://extension/bin/windows/debug/princess_mate_core.dll"
windows.release.x86_64 = "res://extension/bin/windows/release/princess_mate_core.dll"
linux.debug.x86_64 = "res://extension/bin/linux/debug/libprincess_mate_core.so"
linux.release.x86_64 = "res://extension/bin/linux/release/libprincess_mate_core.so"
macos.debug = "res://extension/bin/macos/debug/libprincess_mate_core.dylib"
macos.release = "res://extension/bin/macos/release/libprincess_mate_core.dylib"
macos.debug.arm64 = "res://extension/bin/macos/debug/libprincess_mate_core.dylib"
macos.release.arm64 = "res://extension/bin/macos/release/libprincess_mate_core.dylib"
